APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://agentgate:agentgate@localhost:5432/agentgate
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

LOCAL_FILE_ROOT=demo_data
ALLOWED_FILESYSTEM_PATHS=/tmp/agentgate

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/gmail/callback

# LLM provider
# LLM_TYPE: openai (OpenAI-compatible chat completions) | anthropic (Messages API)
LLM_TYPE=openai
LLM_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openrouter/free
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TOOLS_ENABLED=True
LLM_MAX_TOOL_ITERATIONS=5
# Provider-specific request plugins (e.g. response-healing). Kosong = field
# 'plugins' tidak dikirim (banyak provider menolaknya).
LLM_PLUGINS=

# Planner validation rules (optional; defaults in settings.py).
# Comma-separated, e.g.: ALLOWED_ACTION_TYPES=BROWSER_OPEN,BROWSER_CLICK
# ALLOWED_ACTION_TYPES=
# ALLOWED_TARGET_SYSTEMS=
# ALLOWED_DOMAINS=
# ALLOWED_RISK_HINTS=
# INTERACTIVE_BROWSER_ACTIONS=
# DOMAIN_BY_TARGET_SYSTEM={}

# Guardrail: dedicated LLM judge (rules stay the safe fallback)
# Set true to have a dedicated model review every non-BLOCK decision.
GUARDRAIL_LLM_ENABLED=False
# Empty -> falls back to LLM_MODEL
GUARDRAIL_MODEL=
# Which risk_hints the rule engine treats as BLOCK vs NEED_APPROVAL
# (subsets of ALLOWED_RISK_HINTS; comma-separated overrides allowed).
# GUARDRAIL_BLOCK_HINTS=destructive,unauthorized,data_exfiltration
# GUARDRAIL_NEED_APPROVAL_HINTS=external_send,payment,bulk_action,refund
# GUARDRAIL_ASK_USER_HINTS=ambiguous_target,missing_target,clarification_needed
# Default domain when a step/action carries none.
# DEFAULT_DOMAIN=productivity

# Reactive agent loop
AGENT_MAX_STEPS=12
AGENT_MAX_REPLAN=4
AGENT_WAIT_RESPONSE_TIMEOUT_SEC=600
AGENT_RUN_TIMEOUT_SEC=900
SSE_HEARTBEAT_SEC=15
RUN_REGISTRY_MAX_SESSIONS=500

PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_MAX_ELEMENTS=50
BROWSER_MAX_CONCURRENT_SESSIONS=10
# Browser navigation defaults (shared by executor, accessibility tool, demo)
# BROWSER_WAIT_UNTIL=domcontentloaded
# BROWSER_TIMEOUT_MS=15000
# Empty -> Chrome-124 default in app/domains/browser/browser_profile.py
# BROWSER_USER_AGENT=

AUDIT_LOG_PATH=artifacts/audit/events.jsonl
TRACE_LOG_PATH=artifacts/traces/actions.jsonl
AUDIT_RETENTION_DAYS=7
TRACE_RETENTION_DAYS=7
SCREENSHOT_RETENTION_DAYS=7
DATA_DIR=./data
AUDIT_BACKEND=postgres # or jsonl