# Copy to .env for local development.
# .env is gitignored — never commit real values.
APP_ENV=development
DEBUG=True
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+psycopg://agentgate:agentgate@localhost:5432/agentgate
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

LOCAL_FILE_ROOT=demo_data
ALLOWED_FILESYSTEM_PATHS=["/tmp/agentgate"]

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/gmail/callback

LLM_TYPE=openai
LLM_URL=https://omni.noctican.my.id/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_TIMEOUT=60
LLM_TOOLS_ENABLED=True
LLM_MAX_TOOL_ITERATIONS=5

PLAYWRIGHT_HEADLESS=False
PLAYWRIGHT_MAX_ELEMENTS=50
BROWSER_MAX_CONCURRENT_SESSIONS=10

AUDIT_LOG_PATH=artifacts/audit/events.jsonl
TRACE_LOG_PATH=artifacts/traces/actions.jsonl
AUDIT_RETENTION_DAYS=7
TRACE_RETENTION_DAYS=7
SCREENSHOT_RETENTION_DAYS=7
DATA_DIR=./data
AUDIT_BACKEND=jsonl
