# Staging environment.
# Fill with staging/test credentials via CI/CD encrypted vars.
APP_ENV=staging
DEBUG=False
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://agentgate:agentgate@staging-db:5432/agentgate
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

LOCAL_FILE_ROOT=demo_data
ALLOWED_FILESYSTEM_PATHS=["/tmp/agentgate"]
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=60

PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_MAX_ELEMENTS=50
BROWSER_MAX_CONCURRENT_SESSIONS=25

AUDIT_LOG_PATH=artifacts/audit/events.jsonl
TRACE_LOG_PATH=artifacts/traces/actions.jsonl
AUDIT_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=14
SCREENSHOT_RETENTION_DAYS=7
DATA_DIR=./data
AUDIT_BACKEND=postgres